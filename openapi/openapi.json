{
  "openapi": "3.0.3",
  "info": {
    "title": "Secure License API",
    "version": "1.0.0",
    "description": "A deliberately small serverless API demonstrating secure-by-design authorization and DevSecOps controls."
  },
  "servers": [
    {
      "url": "https://{apiId}.execute-api.{region}.amazonaws.com/{stage}",
      "variables": {
        "apiId": { "default": "example" },
        "region": { "default": "us-east-1" },
        "stage": { "default": "dev" }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/licenses": {
      "post": {
        "summary": "Create a license",
        "security": [{ "cognito": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLicense" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "License created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LicenseResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/licenses/{license_id}": {
      "parameters": [{ "$ref": "#/components/parameters/LicenseId" }],
      "get": {
        "summary": "Read an owned license",
        "security": [{ "cognito": [] }],
        "responses": {
          "200": {
            "description": "License found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LicenseResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete a license as an administrator",
        "security": [{ "cognito": [] }],
        "responses": {
          "200": { "description": "License deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/licenses/{license_id}/validate": {
      "parameters": [{ "$ref": "#/components/parameters/LicenseId" }],
      "post": {
        "summary": "Validate an owned license",
        "security": [{ "cognito": [] }],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cognito": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.auth.us-east-1.amazoncognito.com/oauth2/authorize",
            "tokenUrl": "https://example.auth.us-east-1.amazoncognito.com/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "parameters": {
      "LicenseId": {
        "name": "license_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "request_id"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "request_id": { "type": "string" }
        }
      },
      "CreateLicense": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "expires_at"],
        "properties": {
          "product_id": { "type": "string", "minLength": 2, "maxLength": 64 },
          "owner_sub": { "type": "string", "description": "Administrators only when different from the caller." },
          "expires_at": { "type": "string", "format": "date-time" },
          "metadata": {
            "type": "object",
            "maxProperties": 10,
            "additionalProperties": { "type": "string", "maxLength": 200 }
          }
        }
      },
      "License": {
        "type": "object",
        "required": ["license_id", "product_id", "owner_sub", "expires_at", "created_at", "revoked"],
        "properties": {
          "license_id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "string" },
          "owner_sub": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "revoked": { "type": "boolean" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
          "last_validated_at": { "type": "string", "format": "date-time" }
        }
      },
      "LicenseResponse": {
        "type": "object",
        "required": ["license", "request_id"],
        "properties": {
          "license": { "$ref": "#/components/schemas/License" },
          "request_id": { "type": "string" }
        }
      },
      "ValidationResult": {
        "type": "object",
        "required": ["license_id", "valid", "reason", "validated_at", "request_id"],
        "properties": {
          "license_id": { "type": "string", "format": "uuid" },
          "valid": { "type": "boolean" },
          "reason": { "type": "string", "enum": ["active", "expired", "revoked"] },
          "validated_at": { "type": "string", "format": "date-time" },
          "request_id": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Insufficient privileges",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
